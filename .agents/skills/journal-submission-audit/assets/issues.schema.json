{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Journal Submission Audit issue register",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "files", "issues"],
  "properties": {
    "version": {"const": "1.0"},
    "extraction": {"type": "object"},
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "role", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "path": {"$ref": "#/$defs/text"},
        "role": {"enum": ["main", "si", "reference", "data", "other"]},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "location": {
      "type": "object", "additionalProperties": false,
      "required": ["file_id", "quote"],
      "properties": {
        "file_id": {"$ref": "#/$defs/id"},
        "quote": {"type": "string"},
        "section": {"type": "string"},
        "label": {"type": "string"},
        "paragraph": {"type": "integer", "minimum": 1},
        "line": {"type": "integer", "minimum": 1},
        "page": {"type": "integer", "minimum": 1},
        "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
        "verified_visual": {"type": "boolean"}
      },
      "oneOf": [
        {"required": ["paragraph"], "not": {"anyOf": [{"required": ["line"]}, {"required": ["page"]}]}},
        {"required": ["line"], "not": {"anyOf": [{"required": ["paragraph"]}, {"required": ["page"]}]}},
        {"required": ["page"], "not": {"anyOf": [{"required": ["line"]}, {"required": ["paragraph"]}]}}
      ],
      "allOf": [
        {"if": {"required": ["bbox"]}, "then": {"required": ["page", "verified_visual"], "properties": {"verified_visual": {"const": true}}}}
      ]
    },
    "issue": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "priority", "confidence", "category", "perspective", "problem", "evidence", "impact", "action", "effort", "requires_author_confirmation", "locations"],
      "properties": {
        "id": {"type": "string", "pattern": "^JSA-[0-9]{4,}$"},
        "priority": {"enum": ["P0", "P1", "P2", "P3"]},
        "confidence": {"enum": ["confirmed", "probable", "question"]},
        "category": {"$ref": "#/$defs/text"},
        "perspective": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["technical", "editor", "domain_reviewer", "methods_reviewer", "application_reviewer", "language"]}},
        "problem": {"$ref": "#/$defs/text"},
        "evidence": {"$ref": "#/$defs/text"},
        "impact": {"$ref": "#/$defs/text"},
        "action": {"$ref": "#/$defs/text"},
        "effort": {"enum": ["text", "analysis", "experiment", "verification"]},
        "requires_author_confirmation": {"type": "boolean"},
        "meaning_change": {"type": "boolean"},
        "suggested_english": {"type": "string"},
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^JSA-[0-9]{4,}$"}},
        "status": {"enum": ["open", "resolved", "deferred", "disputed"]},
        "locations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/location"}}
      }
    }
  }
}
